# Backend Environment Configuration Example
# Copy this file to .env and configure the values

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/logistics_db

# TomTom Traffic API key (used in Phase 5+)
TOMTOM_API_KEY=your_tomtom_api_key_here

# JWT Secret for authentication (used in Phase 6+)
JWT_SECRET=your_jwt_secret_key_here

# Application Environment (development, production, test)
APP_ENV=development
