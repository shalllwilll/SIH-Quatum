# Abraxas Backend Environment Configuration Example
# Copy this file to backend/.env and customize as needed.

# -----------------------------------------------------------------------------
# 1. Database Configuration (Required)
# -----------------------------------------------------------------------------
# MongoDB connection URI (e.g. local instance or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/logistics_db

# -----------------------------------------------------------------------------
# 2. TomTom Live Traffic API (Optional for dev/demo; fallback curve active if missing)
# -----------------------------------------------------------------------------
# Obtain free API key from https://developer.tomtom.com (2,500 free queries/day)
TOMTOM_API_KEY=your_tomtom_api_key_here

# -----------------------------------------------------------------------------
# 3. Security & Authentication
# -----------------------------------------------------------------------------
# Secret key used for signing HS256 JWT tokens
JWT_SECRET=abraxas_production_jwt_secret_key_demo_2026

# Application environment: development | production | test
APP_ENV=development

# -----------------------------------------------------------------------------
# 4. Simulation & Acceleration Parameters
# -----------------------------------------------------------------------------
# Clock acceleration ratio (e.g. 60.0 means 1 real minute = 1 simulated hour)
CLOCK_ACCELERATION_RATIO=60.0

# Initial simulation start time in minutes since midnight (e.g. 540 = 09:00 AM)
SIMULATION_START_TIME_MIN=540.0
