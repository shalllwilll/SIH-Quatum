# Abraxas Admin Web Portal — Environment Variables
# Copy to frontend-admin/.env.local or frontend-admin/.env

# Base URL for the FastAPI Backend API
VITE_API_BASE_URL=http://localhost:8000

# Optional: CARTO Basemaps API key (from https://carto.com/basemaps/apikey)
# If left empty, default high-contrast ESRI Dark Canvas basemap is used with no API key required
VITE_CARTO_API_KEY=
